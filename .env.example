# Banco (Neon Postgres) - use o JDBC URL, com sslmode=require
DATABASE_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=
# JPA_DDL_AUTO=update

# JWT (mínimo 32 caracteres) - gere com: openssl rand -base64 48
JWT_KEY=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS / URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Sistema Agendamento

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Swagger (somente dev)
SWAGGER_ENABLED=false
